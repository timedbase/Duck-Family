# RainbowKit's WalletConnect connector needs a project id -- free account at
# https://cloud.reown.com. Injected wallets (MetaMask, Rabby, etc.) work
# without one; only the WalletConnect option in the connect modal needs it.
VITE_WALLETCONNECT_PROJECT_ID=

# The trading backend -- only used here for its IPFS upload endpoints
# (POST /upload/image, /upload/metadata), which need the server-side
# Pinata JWT this app never has access to. Everything else in this app
# talks straight to the chain and the public subgraph.
VITE_API_URL=http://localhost:3000
